# Ignore dependencies and build artifacts from host
node_modules/
.pnpm-store/
dist/
build/

# Ignore sensitive files (gunakan env_file di docker-compose atau environment variables)
.env
.env.local
.env.*
!.env.example

# Ignore logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Ignore Git and OS files
.git/
.gitignore
.dockerignore
.DS_Store
Thumbs.db
.vscode/
.idea/

# Ignore local uploaded files (agar image docker bersih)
public/images/*
!public/images/.gitkeep
public/files/*
!public/files/.gitkeep
public/videos/*
!public/videos/.gitkeep
