NODE_ENV="development"
HOST="localhost"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/gpsi_soteria?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/gpsi_soteria?schema=public"

# jwt tokenizer authentication
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_EXPIRES_IN="your-jwt-expires-in"
HASH_ROUNDS="your-hash-bcrypt-rounds"

# Google Authentication
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_TOKEN_INFO_URL="https://oauth2.googleapis.com/tokeninfo"

# Facebook Authentication
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_GRAPH_URL="https://graph.facebook.com/v19.0/me"


